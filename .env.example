# ============================================
# ClassifyPro Environment Configuration
# ============================================
# Copy this file to .env and fill in your own values

# ============================================
# Supabase Configuration
# ============================================
# Get these from https://app.supabase.com/project/[your-project-id]/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# School Location (Default: Lagos, Nigeria)
# ============================================
# Replace with your school's GPS coordinates
EXPO_PUBLIC_SCHOOL_LAT=6.9271  # Default: Lekki, Lagos
EXPO_PUBLIC_SCHOOL_LON=3.3955  # Default: Lekki, Lagos

# ============================================
# Geofencing Configuration
# ============================================
# Geofence radius in meters (default: 100m)
EXPO_PUBLIC_GEOFENCE_RADIUS=100

# ============================================
# App Configuration
# ============================================
# API environment
EXPO_PUBLIC_ENV=development

# Optional: File upload service (for selfies and report cards)
EXPO_PUBLIC_STORAGE_URL=https://your-storage-url.com

# Optional: Email/SMS service
EXPO_PUBLIC_EMAIL_SERVICE_KEY=optional-key
EXPO_PUBLIC_SMS_SERVICE_KEY=optional-key
