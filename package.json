{
  "name": "classifypro-mobile",
  "version": "1.0.0",
  "description": "Smart school attendance and academic management system with geofencing",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "install-deps": "npm install --legacy-peer-deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "expo": "~50.0.0",
    "expo-camera": "~14.1.0",
    "expo-location": "~17.0.1",
    "expo-status-bar": "~1.11.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.73.0",
    "react-native-web": "~0.19.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.73.0",
    "typescript": "~5.3.0"
  }
}
